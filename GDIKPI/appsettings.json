{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ManufacturingKpiDemo;Integrated Security=true;TrustServerCertificate=true;MultipleActiveResultSets=True;"
  },
  "ExternalApi": {
    "BaseUrl": "http://localhost:9091",
    "Timeout": 30
  },
  "AttendanceApi": {
    "BaseUrl": "http://localhost:9092",
    "Timeout": 30
  },
  "ScannerValidation": {
    "ZF": {
      "Enabled": false,
      "AllowedPrefixes": [
        "DEMO"
      ],
      "AllowedSuffixes": [
        "SAMPLE"
      ]
    }
  },
  "ProductionLineScanner": {
    "BatchInactivitySeconds": 60
  },
  "AllowedHosts": "*"
}
