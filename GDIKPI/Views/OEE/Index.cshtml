@{
    ViewData["Title"] = "Index";
}

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    .card-stats {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

        .card-stats:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

    .stat-icon {
        width: 4rem;
        height: 4rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem auto;
    }


    .category-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 8px;
    }

    .chart-container {
        position: relative;
        height: 300px;
    }

    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        border-color: #0d6efd;
        color: white;
    }

    .nav-tabs .nav-link {
        color: #6c757d;
    }

    .table-container {
        background: white;
        border-radius: 0.375rem;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter,
    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate {
        margin: 0.75rem 0;
    }

        .dataTables_wrapper .dataTables_filter input {
            border-radius: 0.375rem;
            border: 1px solid #dee2e6;
            padding: 0.375rem 0.75rem;
        }

        .dataTables_wrapper .dataTables_length select {
            border-radius: 0.375rem;
            border: 1px solid #dee2e6;
            padding: 0.375rem 0.75rem;
        }

    .btn-action {
        padding: 0.25rem 0.5rem;
        margin: 0 0.125rem;
        border-radius: 0.25rem;
        border: none;
        font-size: 0.875rem;
    }

    .status-badge {
        padding: 0.25rem 0.5rem;
        border-radius: 0.375rem;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .bg-gradient-danger {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    }

    .bg-gradient-warning {
        background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
    }

    .bg-gradient-success {
        background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
    }

    .badge {
        font-weight: 600;
        letter-spacing: 0.025em;
        font-size: 0.875em;
        padding: 0.6em 1em;
        transition: all 0.2s ease-in-out;
    }

        .badge:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 8px rgba(0,0,0,0.15);
        }

    /* Animación para estados críticos */
    .pulse-animation {
        animation: pulse 2s infinite;
    }

    /* Estilos para filtros compactos */
    .filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        align-items: end;
    }

    .filter-item {
        flex: 1;
        min-width: 150px;
        max-width: 200px;
    }

        .filter-item label {
            font-size: 0.875rem;
            font-weight: 500;
            margin-bottom: 0.25rem;
            display: block;
        }

        .filter-item .form-select,
        .filter-item .form-control {
            font-size: 0.875rem;
            padding: 0.375rem 0.5rem;
            height: calc(1.5em + 0.75rem + 2px);
        }

    /* Responsive para filtros */
    media (max-width: 768px) {
        .filter-item

    {
        min-width: 120px;
        max-width: 150px;
    }

    .filter-item .form-select,
    .filter-item .form-control {
        font-size: 0.8rem;
        padding: 0.25rem 0.4rem;
    }

    }
</style>

<!-- Header -->
<nav class="navbar navbar-expand-lg navbar-dark bg-gradient-primary">
    <div class="container-fluid">
        <div class="d-flex justify-content-between w-100 align-items-center">
            <div>
                <h1 class="navbar-brand mb-0 h1">
                    <i class="fas fa-chart-line me-2"></i>
                    Dashboard OEE
                </h1>
                <small class="text-white-50">Monitoreo de Tiempos Muertos y Ausentismos - Líneas de Producción</small>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-light btn-sm" id="btnParameters">
                    <i class="fa-solid fa-gear"></i>
                    Parametros
                </button>
                <button class="btn btn-outline-light btn-sm" id="btnExportar">
                    <i class="fas fa-download me-1"></i>
                    Exportar
                </button>
            </div>
        </div>
    </div>
</nav>

<div class="container-fluid py-4">
    <!-- KPI Cards -->
    <div class="row g-4 mb-4">
        <!-- OEE Total -->
        <div class="col-md-6 col-lg-3">
            <div class="card card-stats h-100 text-center">
                <div class="card-body">
                    <div class="stat-icon bg-primary bg-opacity-10">
                        <i class="fas fa-chart-line text-primary fs-3"></i>
                    </div>
                    <h6 class="card-subtitle mb-2 text-muted">OEE Total</h6>
                    <h2 class="card-title  mb-1" id="oeeTotal"></h2>

                </div>
            </div>
        </div>
        <!-- Disponibilidad -->
        <div class="col-md-6 col-lg-3">
            <div class="card card-stats h-100 text-center">
                <div class="card-body">
                    <div class="stat-icon bg-success bg-opacity-10">
                        <i class="fas fa-check-circle text-success fs-3"></i>
                    </div>
                    <h6 class="card-subtitle mb-2 text-muted">Disponibilidad</h6>
                    <h2 class="card-title  mb-1" id="availability"></h2>

                </div>
            </div>
        </div>

        <!-- Rendimiento -->
        <div class="col-md-6 col-lg-3">
            <div class="card card-stats h-100 text-center">
                <div class="card-body">
                    <div class="stat-icon bg-danger bg-opacity-10">
                        <i class="fas fa-pause-circle text-danger fs-3"></i>
                    </div>
                    <h6 class="card-subtitle mb-2 text-muted">Rendimiento</h6>
                    <h2 class="card-title  mb-1" id="performance"></h2>

                </div>
            </div>
        </div>

        <!-- Calidad -->
        <div class="col-md-6 col-lg-3">
            <div class="card card-stats h-100 text-center">
                <div class="card-body">
                    <div class="stat-icon bg-warning bg-opacity-10">
                        <i class="fa-solid fa-star text-warning fs-3"></i>
                   
                    </div>

                    <h6 class="card-subtitle mb-2 text-muted">Calidad</h6>
                    <h2 class="card-title  mb-1" id="quality"></h2>

                </div>
            </div>
        </div>
    </div>

    <!-- Data Tables Section -->
    <div class="card table-container">
        <!-- Filters - Ahora en una sola fila -->
        <div class="card-body border-bottom">
            <div class="filter-row">
                <div class="filter-item">
                    <label class="form-label">Tipo</label>
                    <select class="form-select" id="downTimeFilter">
                        <option value="">Todos los Tipos</option>
                        <option value="Ausentismo">Ausentismo</option>
                        <option value="Tiempo Muerto">Tiempo Muerto</option>
                        <option value="Sin Incidencias">Sin Incidencias</option>
                    </select>
                </div>
                <div class="filter-item">
                    <label class="form-label">Area</label>
                    <select class="form-select" id="areaFilter">
                        <option value="">Todas las areas</option>
                        @if (ViewBag.Areaslist is SelectList areaList)
                        {
                            foreach (var area in areaList)
                            {
                                <option value="@area.Value">@area.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="filter-item">
                    <label class="form-label">Línea de Producción</label>
                    <select class="form-select" id="lineFilter">
                        <option value="">Seleccione un Area</option>
                        @if (ViewBag.LinesNumberList is SelectList lineList)
                        {
                            foreach (var linea in lineList)
                            {
                                <option value="@linea.Value">@linea.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="filter-item">
                    <label class="form-label">Descripción</label>
                    <select class="form-select" id="descriptionFilter">
                        <option value="">Todas las descripciones</option>
                        @if (ViewBag.DescriptionList is SelectList descriptionList)
                        {
                            foreach (var description in descriptionList)
                            {
                                <option value="@description.Value">@description.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="filter-item">
                    <label class="form-label">Estado</label>
                    <select class="form-select" id="statusFilter">
                        <option value="">Todos los estados</option>
                        <option value="Activo">Activo</option>
                        <option value="Abierto">Abierto</option>
                        <option value="Cerrado">Cerrado</option>
                    </select>
                </div>
                <div class="filter-item">
                    <label class="form-label">Fecha inicio</label>
                    <input type="date" class="form-control" id="startDateFilter">
                </div>
                <div class="filter-item">
                    <label class="form-label">Fecha fin</label>
                    <input type="date" class="form-control" id="endDateFilter">
                </div>
            </div>
        </div>

        <div class="table-responsive mt-3">
            <table class="table table-striped table-hover" id="DataTable">
                <thead class="table-light">
                    <tr>
                        <th>Tipo</th>
                        <th>Area</th>
                        <th>Linea</th>
                        <th>Fecha</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded here -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal para Parámetros OEE -->
<div class="modal fade" id="AddOEEParamModal" tabindex="-1" aria-labelledby="AddOEEParamModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
           
        </div>
    </div>
</div>


<!-- Scripts al final de la página -->
<!-- jQuery (si no está en el layout, inclúyelo aquí) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<!-- DataTables -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables/1.10.21/js/jquery.dataTables.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables/1.10.21/js/dataTables.bootstrap5.min.js"></script>

<!-- Chart.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>

<!-- Tu script personalizado AL FINAL -->
<script src="~/js/OEE/list.js"></script>
<script src="~/js/OEE/registerParameters.js"></script>