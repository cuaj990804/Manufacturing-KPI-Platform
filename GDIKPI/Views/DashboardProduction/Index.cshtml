@{
    ViewData["Title"] = ViewBag.AreaName != null ? $"Dashboard Producción - {ViewBag.AreaName}" : "Dashboard Producción";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link rel="stylesheet" href="/css/dashboardproduction/cards.css" asp-append-version="true">
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-triangle"></i> @ViewBag.ErrorMessage
    </div>
}


@* Campo hidden para que JavaScript pueda acceder al areaId *@
@if (ViewBag.AreaId != null)
{
    <input type="hidden" id="area-id-hidden" value="@ViewBag.AreaId" />
}

<!-- Botón de cerrar sesión oculto -->
<div class="logout-button-container">
    <a href="/Account/Logout" class="logout-button" title="Cerrar Sesión">
        <i class="fas fa-sign-out-alt"></i>
    </a>
</div>

<button type="button" id="dashboard-config-toggle" class="dashboard-config-toggle" title="Configurar tarjetas">
    <i class="fas fa-sliders-h"></i>
</button>

<aside id="dashboard-config-panel" class="dashboard-config-panel" aria-label="Configurar tarjetas">
    <div class="dashboard-config-header">
        <div>
            <div class="dashboard-config-title">Tarjetas visibles</div>
            <div class="dashboard-config-subtitle">Selecciona las lineas que quieres ver</div>
        </div>
        <button type="button" id="dashboard-config-close" class="dashboard-config-close" title="Cerrar">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <div id="dashboard-card-options" class="dashboard-card-options">
        <div class="dashboard-config-empty">Cargando lineas...</div>
    </div>

    <div class="dashboard-config-actions">
        <button type="button" id="dashboard-select-all" class="dashboard-config-action">Mostrar todas</button>
        <button type="button" id="dashboard-clear-all" class="dashboard-config-action secondary">Ocultar todas</button>
        <button type="button" id="dashboard-confirm-visibility" class="dashboard-config-action confirm" disabled>Confirmar</button>
    </div>
</aside>

<div class="dashboard" id="cards-container">
    <!-- Las tarjetas se cargan dinámicamente -->
</div>



@section Scripts {
    <script>
        window.dashboardConfig = {
            areaId: @(ViewBag.AreaId != null ? ViewBag.AreaId : "null"),
            areas: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Areas ?? new List<object>()))
        };
    </script>
    <script src="https://unpkg.com/@@microsoft/signalr@latest/dist/browser/signalr.min.js"></script>
    <script src="~/js/DashboardProduction/dashboard.js" asp-append-version="true"></script>
}
