<script>
    // Configurar datos del modelo para JavaScript
    window.EditProductionLineData = {
        model: {
            areaId: '@Model.AreaId',
            lineNumber: '@Model.LineNumber',
            lineName: '@Model.LineName',
            personalQuantity: '@Model.PersonalQuantity',
            dailyGoal: '@Model.DailyGoal',
            standardTime: '@standardTimeValue',
            isActive: @(Model.IsActive.ToString().ToLower())
        },
        viewBag: {
            break1Start: '@ViewBag.Break1Start',
            break1End: '@ViewBag.Break1End',
            break2Start: '@ViewBag.Break2Start',
            break2End: '@ViewBag.Break2End',
            supervisor: '@ViewBag.Supervisor',
            assignedPermissions: @Html.Raw(Json.Serialize(ViewBag.AssignedPermissions ?? new int[0]))
        }
    };
</script>
<script src="~/js/Areas/editForm.js" asp-append-version="true"></script>
