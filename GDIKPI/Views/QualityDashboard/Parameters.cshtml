@model GDIKPI.Models.PerformanceMetric
@{
    ViewData["Title"] = "Parámetros Calidad";
}
<form id="AddQualityParamForm">
    <div class="modal-header">
        <h5 class="modal-title" id="AddOEEParamModalLabel">Editar Parámetro de Calidad</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
    </div>

    <div class="modal-body">
        <!-- Métrica -->
        <div class="mb-3">
            <label for="metricName" class="form-label">Métrica</label>
            <select class="form-select" id="metricNameQuality" name="MetricName" required>
                <option value="">Selecciona una métrica...</option>
                <option value="Overall">Calidad</option>
                <option value="Reject">Rechazo</option>
                <option value="Scrap">Scrap</option>

            </select>
        </div>

        <!-- Categoría -->
        <div class="mb-3">
            <label for="category" class="form-label">Categoría</label>
            <select class="form-select" id="categoryQuality" name="Category" required>
                <option value="">Selecciona una categoría...</option>
                <option value="Steering wheel">Volantes</option>
                <option value="Back-Cover">Back-Cover</option>
            </select>
        </div>
        <div class="mb-3" id="ParametersContainer">
        </div>



        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-primary">Guardar Parámetro</button>
        </div>
    </div>
</form>
