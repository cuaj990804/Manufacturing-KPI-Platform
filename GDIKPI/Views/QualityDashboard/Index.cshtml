@{
    ViewData["Title"] = "Index";
}

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    .card-stats {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

        .card-stats:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

    .stat-icon {
        width: 4rem;
        height: 4rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem auto;
    }


    .category-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 8px;
    }

    .chart-container {
        position: relative;
        height: 300px;
    }

    .nav-tabs .nav-link.active {
        background-color: #0d6efd;
        border-color: #0d6efd;
        color: white;
    }

    .nav-tabs .nav-link {
        color: #6c757d;
    }

    .table-container {
        background: white;
        border-radius: 0.375rem;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter,
    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate {
        margin: 0.75rem 0;
    }

        .dataTables_wrapper .dataTables_filter input {
            border-radius: 0.375rem;
            border: 1px solid #dee2e6;
            padding: 0.375rem 0.75rem;
        }

        .dataTables_wrapper .dataTables_length select {
            border-radius: 0.375rem;
            border: 1px solid #dee2e6;
            padding: 0.375rem 0.75rem;
        }

    .btn-action {
        padding: 0.25rem 0.5rem;
        margin: 0 0.125rem;
        border-radius: 0.25rem;
        border: none;
        font-size: 0.875rem;
    }

    .status-badge {
        padding: 0.25rem 0.5rem;
        border-radius: 0.375rem;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .bg-gradient-primary {
    background: linear-gradient(135deg, #ff9a3c 0%, #ff6a00 100%);
}




    .bg-gradient-danger {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    }

    .bg-gradient-warning {
        background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
    }

    .bg-gradient-success {
        background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
    }

    .badge {
        font-weight: 600;
        letter-spacing: 0.025em;
        font-size: 0.875em;
        padding: 0.6em 1em;
        transition: all 0.2s ease-in-out;
    }

        .badge:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 8px rgba(0,0,0,0.15);
        }

    /* Animación para estados críticos */
    .pulse-animation {
        animation: pulse 2s infinite;
    }

    /* Estilos para filtros compactos */
    .filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        align-items: end;
    }

    .filter-item {
        flex: 1;
        min-width: 150px;
        max-width: 200px;
    }

        .filter-item label {
            font-size: 0.875rem;
            font-weight: 500;
            margin-bottom: 0.25rem;
            display: block;
        }

        .filter-item .form-select,
        .filter-item .form-control {
            font-size: 0.875rem;
            padding: 0.375rem 0.5rem;
            height: calc(1.5em + 0.75rem + 2px);
        }

    /* Responsive para filtros */
    media (max-width: 768px) {
        .filter-item

    {
        min-width: 120px;
        max-width: 150px;
    }

    .filter-item .form-select,
    .filter-item .form-control {
        font-size: 0.8rem;
        padding: 0.25rem 0.4rem;
    }

    }

    /* Estilos para dropdown con checkboxes */
    .dropdown-menu {
        max-height: 300px;
        overflow-y: auto;
        padding: 0.5rem 0;
    }

    .dropdown-menu .form-check {
        padding: 0.5rem 1.5rem;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .dropdown-menu .form-check:hover {
        background-color: #f8f9fa;
    }

    .dropdown-menu .form-check-input {
        cursor: pointer;
        margin-top: 0;
        margin-left: 0;
        flex-shrink: 0;
    }

    .dropdown-menu .form-check-label {
        cursor: pointer;
        width: 100%;
        margin-bottom: 0;
        padding-left: 0;
    }

    /* Evitar que el dropdown se cierre al hacer click en checkboxes */
    .dropdown-menu .form-check {
        cursor: pointer;
    }

    #lineFilterDropdown {
        height: calc(1.5em + 0.75rem + 2px);
        font-size: 0.875rem;
        padding: 0.375rem 0.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    #lineFilterLabel {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        flex: 1;
    }

    .dropdown-menu li.px-3 {
        padding-left: 1.5rem !important;
        padding-right: 1.5rem !important;
    }
</style>

<!-- Header -->
<nav class="navbar navbar-expand-lg navbar-dark bg-gradient-primary">
    <div class="container-fluid">
        <div class="d-flex justify-content-between w-100 align-items-center">
            <div>
                <h1 class="navbar-brand mb-0 h1">
                    <i class="fas fa-chart-line me-2"></i>
                    Dashboard de calidad
                </h1>
                <small class="text-white-50">Monitoreo de rechazos y defectos </small>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-light btn-sm" id="btnQualityParameters">
                    <i class="fa-solid fa-gear"></i>
                    Parametros
                </button>
                <button class="btn btn-outline-light btn-sm" id="btnQualityExport">
                    <i class="fas fa-download me-1"></i>
                    Exportar
                </button>
            </div>
        </div>
    </div>
</nav>
<!-- KPI Cards alineadas al ancho de la tabla -->
<div class="d-flex w-100 mb-5 mt-5">
    <!-- Card Calidad % -->
    <div class="card card-stats text-center flex-fill me-2">
        <div class="card-body">
            <div class="stat-icon bg-warning bg-opacity-10">
                <i class="fa-solid fa-star text-warning fs-3"></i>
            </div>
            <h6 class="card-subtitle mb-2 text-muted">Porcentaje de calidad</h6>
            <h2 class="card-title mb-1" id="qualityTotal"></h2>
        </div>
    </div>

    <!-- Card Scrap -->
    <div class="card card-stats text-center flex-fill me-2">
        <div class="card-body">
            <div class="stat-icon bg-primary bg-opacity-10">
                <i class="fa-solid fa-bug text-primary fs-3"></i>
            </div>
            <h6 class="card-subtitle mb-2 text-muted">Porcentaje de Scrap</h6>
            <h2 class="card-title mb-1" id="scrapTotal"></h2>
        </div>
    </div>

    <!-- Card Retrabajo -->
    <div class="card card-stats text-center flex-fill me-2">
        <div class="card-body">
            <div class="stat-icon bg-info bg-opacity-10">
                <i class="fa-solid fa-repeat text-info fs-3"></i>
            </div>
            <h6 class="card-subtitle mb-2 text-muted">Porcentaje de Rechazo</h6>
            <h2 class="card-title mb-1" id="reworksTotal"></h2>
        </div>
    </div>

    <!-- Card Producción -->
    <div class="card card-stats text-center flex-fill me-2">
        <div class="card-body">
            <div class="stat-icon bg-success bg-opacity-10">
                <i class="fa-solid fa-industry text-success fs-3"></i>
            </div>
            <h6 class="card-subtitle mb-2 text-muted">Cantidad producida</h6>
            <h2 class="card-title mb-1" id="producedQuantities"></h2>
        </div>
    </div>
    <!-- Card Piezas Rechazadas -->
    <div class="card card-stats text-center flex-fill ms-2">
        <div class="card-body">
            <div class="stat-icon bg-danger bg-opacity-10">
                <i class="fa-solid fa-ban text-danger fs-3"></i>
            </div>
            <h6 class="card-subtitle mb-2 text-muted">Cantidad Rechazada</h6>
            <h2 class="card-title mb-1" id="rejectedPieces"></h2>
        </div>
    </div>

    <!-- Card Scrap Cantidad -->
    <div class="card card-stats text-center flex-fill me-2">
        <div class="card-body">
            <div class="stat-icon bg-danger bg-opacity-10">
                <i class="fa-solid fa-xmark text-danger fs-3"></i>
            </div>
            <h6 class="card-subtitle mb-2 text-muted">Cantidad de scrap</h6>
            <h2 class="card-title mb-1" id="scrapQuantities"></h2>
        </div>
    </div>

    <!-- Card Total de Defectos -->
    <div class="card card-stats text-center flex-fill">
        <div class="card-body">
            <div class="stat-icon bg-warning bg-opacity-10">
                <i class="fa-solid fa-exclamation-triangle text-warning fs-3"></i>
            </div>
            <h6 class="card-subtitle mb-2 text-muted">Total de Defectos</h6>
            <h2 class="card-title mb-1" id="totalDefects"></h2>
        </div>
    </div>
</div>

<!-- Pareto Chart Section -->
<div class="card mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0">
            <i class="fas fa-chart-bar me-2"></i>
            Pareto por Defecto
        </h5>
    </div>
    <div class="card-body">
        <div style="position: relative; height: 400px;">
            <canvas id="paretoChart"></canvas>
        </div>
    </div>
</div>

    <!-- Data Tables Section -->
    <div class="card table-container">
        <!-- Filters - Ahora en una sola fila -->
        <div class="card-body border-bottom">
            <div class="filter-row">
               
                <div class="filter-item">
                    <label class="form-label">Area</label>
                    <select class="form-select" id="areaFilter">
                        <option value="">Todas las areas</option>
                        @if (ViewBag.Areaslist is SelectList areaList)
                        {
                            foreach (var area in areaList)
                            {
                                <option value="@area.Value">@area.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="filter-item">
                    <label class="form-label">Línea de Producción</label>
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" id="lineFilterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <span id="lineFilterLabel">Seleccione líneas</span>
                        </button>
                        <ul class="dropdown-menu w-100" aria-labelledby="lineFilterDropdown" id="lineFilterMenu">
                            <li class="px-3 py-2 text-muted">Seleccione un área primero</li>
                        </ul>
                    </div>
                </div>
                <div class="filter-item">
                    <label class="form-label">Programa</label>
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" id="programFilterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <span id="programFilterLabel">Seleccione programas</span>
                        </button>
                        <ul class="dropdown-menu w-100" aria-labelledby="programFilterDropdown" id="programFilterMenu">
                            <li class="px-3 py-2 text-muted">Seleccione un área primero</li>
                        </ul>
                    </div>
                </div>
                <div class="filter-item">
                    <label class="form-label">Categoría de Defecto</label>
                    <select class="form-select" id="defectCategoryFilter">
                        <option value="">Todas las categorias </option>
                        @if (ViewBag.DefectCategoryList is SelectList defectCategoryList)
                        {
                            foreach (var defectCategory in defectCategoryList)
                            {
                                <option value="@defectCategory.Value">@defectCategory.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="filter-item">
                    <label class="form-label">Defecto</label>
                    <select class="form-select" id="defectFilter">
                        <option value="">Todos los Defectos</option>
                        @if (ViewBag.DefectList is SelectList descriptionList)
                        {
                            foreach (var description in descriptionList)
                            {
                                <option value="@description.Value">@description.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="filter-item">
                    <label class="form-label">Fecha inicio</label>
                    <input type="date" class="form-control" id="startDateFilter">
                </div>
                <div class="filter-item">
                    <label class="form-label">Fecha fin</label>
                    <input type="date" class="form-control" id="endDateFilter">
                </div>
                <div class="filter-item">
                    <label class="form-label">Hora inicio</label>
                    <input type="time" step="1" class="form-control" id="startTimeFilter">
                </div>
                <div class="filter-item">
                    <label class="form-label">Hora fin</label>
                    <input type="time" step="1" class="form-control" id="endTimeFilter">
                </div>
            </div>
        </div>

        <div class="table-responsive mt-3">
            <table class="table table-striped table-hover" id="DataTable">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Area</th>
                        <th>Linea</th>
                        <th>Programa</th>
                        <th>Defecto</th>
                        <th>Total</th>
                        
                    </tr>
                </thead>
                <tbody>
                    <!-- Data will be loaded here -->
                </tbody>
            </table>
        </div>
    </div>


<!-- Modal para Parámetros OEE -->
<div class="modal fade" id="AddQualityParamModal" tabindex="-1" aria-labelledby="AddQualityParamModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
        </div>
    </div>
</div>


<!-- Scripts al final de la página -->
<!-- jQuery (si no está en el layout, inclúyelo aquí) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<!-- DataTables -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables/1.10.21/js/jquery.dataTables.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables/1.10.21/js/dataTables.bootstrap5.min.js"></script>

<!-- Chart.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>

<!-- Tu script personalizado AL FINAL -->
<script src="~/js/QualityDashboard/list.js"></script>
<script src="~/js/QualityDashboard/registerParameters.js"></script>
