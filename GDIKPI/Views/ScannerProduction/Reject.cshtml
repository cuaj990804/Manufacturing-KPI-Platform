@{
    Layout = null;
    var lineName = (string?)ViewBag.LineName;
    var lineNumberText = Convert.ToString(ViewBag.LineNumber) ?? "";
    var hasLineName = !string.IsNullOrWhiteSpace(lineName);
    var headerLabel = hasLineName ? "Programa" : "Línea";
    var headerValue = hasLineName ? lineName! : lineNumberText;
    var employeeNumber = Convert.ToString(ViewBag.EmployeeNumber) ?? "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rechazo - @headerValue</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simple-keyboard@latest/build/css/index.css">
    <link rel="stylesheet" href="~/css/scannerProduction/virtual-keyboard.css" asp-append-version="true">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Share Tech Mono', monospace;
            background: radial-gradient(circle at top, #0f172a 0%, #020617 70%);
            color: #e2e8f0;
            min-height: 100vh;
            padding: 1.25rem;
        }

        .page {
            min-height: calc(100vh - 2.5rem);
            display: grid;
            grid-template-rows: 1fr;
            gap: 1rem;
        }

        .page-btn {
            border: none;
            border-radius: 0.8rem;
            padding: 0.9rem 1.2rem;
            font-size: 0.95rem;
            font-family: inherit;
            font-weight: 700;
            cursor: pointer;
        }

        .page-btn-primary {
            background: #16a34a;
            color: #f0fdf4;
        }

        .page-btn-secondary {
            background: #334155;
            color: #e2e8f0;
        }

        .reject-layout {
            display: grid;
            grid-template-columns: minmax(340px, 34vw) minmax(0, 1fr);
            gap: 1rem;
            align-items: stretch;
        }

        .reject-panel {
            background: #020617;
            border: 1px solid #334155;
            border-radius: 1rem;
            padding: 1.1rem;
            display: flex;
            flex-direction: column;
            gap: 0.85rem;
            min-height: 0;
        }

        .reject-panel-scroll {
            min-height: 0;
        }

        .reject-panel h2,
        .reject-panel h3 {
            font-size: 1rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: #93c5fd;
        }

        .reject-field-group {
            display: flex;
            flex-direction: column;
            gap: 0.45rem;
        }

        .reject-field-group label {
            color: #cbd5e1;
            font-size: 0.9rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .reject-field-group input {
            width: 100%;
            background: #020617;
            color: #e2e8f0;
            border: 2px solid #334155;
            border-radius: 0.75rem;
            padding: 0.95rem 1rem;
            outline: none;
            font-size: 1.05rem;
            font-family: inherit;
        }

        .reject-field-group input:focus {
            border-color: #3b82f6;
        }

        .reject-field-group input.input-valid,
        .reject-field-group input.input-valid:focus {
            border-color: #16a34a;
            box-shadow: 0 0 0 1px rgba(22, 163, 74, 0.25);
        }

        .reject-field-group input.input-error,
        .reject-field-group input.input-error:focus {
            border-color: #ef4444;
            box-shadow: 0 0 0 1px rgba(239, 68, 68, 0.25);
        }

        .reject-field-group input:disabled {
            opacity: 0.55;
        }

        .reject-status {
            font-size: 0.95rem;
            padding: 0.85rem 1rem;
            border-radius: 0.75rem;
            border: 1px solid transparent;
        }

        .reject-status.success {
            background: rgba(22, 163, 74, 0.15);
            border-color: #16a34a;
            color: #86efac;
        }

        .reject-status.error {
            background: rgba(239, 68, 68, 0.15);
            border-color: #ef4444;
            color: #fca5a5;
        }

        .reject-current-title,
        .reject-selection-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .reject-current-count,
        .reject-selection-header span {
            color: #94a3b8;
            font-size: 0.9rem;
        }

        #defectsList {
            background: #020617;
            border: 1px solid #334155;
            border-radius: 0.85rem;
            padding: 0.75rem;
            min-height: 96px;
            max-height: min(22vh, 220px);
            overflow-y: auto;
        }

        .defect-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            background: #0b1220;
            border: 1px solid #334155;
            border-radius: 0.75rem;
            padding: 0.9rem 1rem;
            margin-bottom: 0.65rem;
        }

        .defect-item:last-child {
            margin-bottom: 0;
        }

        .defect-item-info {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            min-width: 0;
            flex: 1;
        }

        .defect-item-text {
            display: flex;
            flex-direction: column;
            gap: 0.2rem;
            min-width: 0;
        }

        .defect-item-text strong {
            color: #e2e8f0;
            font-size: 1.05rem;
        }

        .defect-item-text span {
            color: #94a3b8;
            font-size: 0.9rem;
        }

        .defect-item-remove {
            background: transparent;
            border: 1px solid #ef4444;
            color: #fca5a5;
            cursor: pointer;
            padding: 0.5rem 0.9rem;
            border-radius: 0.55rem;
            font-size: 0.95rem;
            font-weight: 700;
        }

        .manual-defects-container {
            min-height: 0;
        }

        .available-defects-list {
            min-height: 0;
            max-height: 52vh;
            overflow-y: auto;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 0.8rem;
            align-content: start;
            padding-right: 0.35rem;
            scrollbar-width: thin;
            scrollbar-color: #475569 #0b1220;
        }

        .available-defects-list::-webkit-scrollbar {
            width: 12px;
        }

        .available-defects-list::-webkit-scrollbar-track {
            background: #0b1220;
            border-radius: 999px;
        }

        .available-defects-list::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 999px;
            border: 2px solid #0b1220;
        }

        .available-defects-list::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }

        .available-defect-item {
            text-align: left;
            border: 1px solid #334155;
            border-radius: 0.9rem;
            background: linear-gradient(180deg, rgba(15, 23, 42, 0.98), rgba(2, 6, 23, 0.98));
            color: #e2e8f0;
            padding: 0.9rem 1rem;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            gap: 1rem;
        }

        .available-defect-item.selected {
            border-color: #16a34a;
            background: linear-gradient(180deg, rgba(20, 83, 45, 0.95), rgba(6, 78, 59, 0.95));
        }

        .available-defect-item-info {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            min-width: 0;
        }

        .available-defect-item-info strong {
            font-size: 1rem;
            color: #f8fafc;
        }

        .available-defect-item-info span,
        .available-defect-item-action {
            color: #94a3b8;
            font-size: 0.85rem;
        }

        .available-defect-item.selected .available-defect-item-action {
            color: #dcfce7;
        }

        .available-defects-empty {
            min-height: 180px;
            display: grid;
            place-items: center;
            border: 1px dashed #334155;
            border-radius: 1rem;
            color: #64748b;
            text-align: center;
            padding: 1rem;
        }

        .footer-actions {
            display: flex;
            justify-content: flex-end;
            gap: 0.75rem;
            flex-wrap: wrap;
            margin-top: auto;
            padding-top: 0.25rem;
        }

        .hidden {
            display: none !important;
        }

        @@media (max-width: 980px) {
            body {
                padding: 0.75rem;
            }

            .page {
                min-height: calc(100vh - 1.5rem);
            }

            .reject-layout {
                grid-template-columns: 1fr;
            }

            .reject-panel-scroll {
                max-height: 52vh;
            }

            .available-defects-list {
                max-height: 42vh;
            }

            #defectsList {
                min-height: 88px;
                max-height: min(18vh, 160px);
            }

            .footer-actions {
                justify-content: stretch;
            }

            .page-btn {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="page">
        <main class="reject-layout">
            <section class="reject-panel reject-panel-scroll">
                <h2>Captura rechazo - @headerValue</h2>

                <div class="reject-field-group">
                    <label for="rejectEmployeeInput">Numero de empleado</label>
                    <input id="rejectEmployeeInput" type="text" placeholder="Numero de empleado" value="@employeeNumber"  disabled/>
                </div>

                <div class="reject-field-group">
                    <label for="rejectPieceInput">Pieza rechazada</label>
                    <input id="rejectPieceInput" type="text" placeholder="Escanea pieza rechazada" inputmode="none" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" />
                </div>

                <div id="rejectPieceStatus" class="reject-status hidden"></div>

                <div class="reject-field-group">
                    <label for="rejectDefectInput">Escanear defecto</label>
                    <input id="rejectDefectInput" type="text" placeholder="Escanea defecto" inputmode="none" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" />
                </div>

                <div class="reject-current-title">
                    <h3>Defectos agregados</h3>
                    <span class="reject-current-count" id="rejectDefectsCount">0 seleccionados</span>
                </div>
                <div id="defectsList" class="hidden"></div>
            </section>

            <section class="reject-panel">
                <div class="reject-selection-header">
                    <h3>Seleccion manual</h3>
                    <span>Defectos del area actual</span>
                </div>

                <div class="reject-field-group">
                    <label for="rejectDefectSearch">Buscar defecto</label>
                    <input id="rejectDefectSearch" type="text" placeholder="Buscar por codigo, nombre o categoria" />
                </div>

                <div class="manual-defects-container">
                    <div id="availableDefectsEmpty" class="available-defects-empty hidden">
                        No hay defectos disponibles para esta area.
                    </div>
                    <div id="availableDefectsList" class="available-defects-list"></div>
                </div>

                <footer class="footer-actions">
                    <button type="button" class="page-btn page-btn-primary" id="confirmRejectBtn" onclick="confirmReject()" disabled>Confirmar rechazo</button>
                    <button type="button" class="page-btn page-btn-secondary" onclick="closeRejectModal()">Volver a scanner</button>
                </footer>
            </section>
        </main>
    </div>

    <div id="scannerVirtualKeyboardHost" class="scanner-virtual-keyboard hidden">
        <div id="scannerVirtualKeyboard" class="simple-keyboard"></div>
    </div>

    <script src="https://unpkg.com/@@microsoft/signalr@latest/dist/browser/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/simple-keyboard@latest/build/index.js"></script>
    <script>
        window.SCANNER_KEYBOARD_SELECTOR = '#rejectDefectSearch';
        window.SCANNER_DATA = {
            productionLineId: @ViewBag.ProductionLineId,
            lineNumber: '@ViewBag.LineNumber',
            dailyGoal: @(ViewBag.DailyGoal ?? 0),
            areaId: @ViewBag.AreaId,
            areaName: '@ViewBag.AreaName',
            customerName: '@ViewBag.CustomerName',
            programName: '@headerValue',
            personalQuantity: @(ViewBag.PersonalQuantity ?? 0),
            standardTime: @(ViewBag.StandardTime ?? 0)
        };

        document.addEventListener('click', (event) => {
            const isInteractiveElement = event.target.closest('button, input, textarea, select');
            if (!isInteractiveElement) {
                const activeInput = document.getElementById('rejectDefectInput')?.disabled
                    ? (document.getElementById('rejectEmployeeInput')?.value ? document.getElementById('rejectPieceInput') : document.getElementById('rejectEmployeeInput'))
                    : document.getElementById('rejectDefectInput');

                if (activeInput) {
                    activeInput.focus();
                }
            }
        });
    </script>

    <script src="~/js/ScannerProduction/constants.js" asp-append-version="true"></script>
    <script src="~/js/ScannerProduction/signalr-connection.js" asp-append-version="true"></script>
    <script src="~/js/ScannerProduction/metrics.js" asp-append-version="true"></script>
    <script src="~/js/ScannerProduction/scanner.js" asp-append-version="true"></script>
    <script src="~/js/ScannerProduction/partNumber.js" asp-append-version="true"></script>
    <script src="~/js/ScannerProduction/reject.js" asp-append-version="true"></script>
    <script src="~/js/ScannerProduction/history.js" asp-append-version="true"></script>
    <script src="~/js/ScannerProduction/main.js" asp-append-version="true"></script>
    <script src="~/js/ScannerProduction/virtual-keyboard.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            await openRejectModal('@employeeNumber');
        });
    </script>
</body>
</html>
