@model IEnumerable<GDIKPI.Models.ProductionDatum>
@{
    ViewData["Title"] = "Production Data";
    var areaId = ViewBag.AreaId ?? 0;
}

<input type="hidden" id="AreaIdHidden" value="@ViewBag.AreaId" />
<link rel="stylesheet" href="/css/tables/tables.css" asp-append-version="true">

<!-- Vista Tablet -->
<div class="tablet-view">
    <div class="tablet-header">
        <h1><i class="fas fa-cogs"></i> Registro de Producción</h1>
        <p class="area-info">Área: @ViewBag.AreaName</p>
    </div>

    <div class="button-grid">
        <button class="action-btn create-btn" data-action="create">
            <div class="btn-icon">
                <i class="fas fa-plus"></i>
            </div>
            <div class="btn-text">Registrar Producción</div>
        </button>

        <button class="action-btn downtime-btn" data-action="downtime">
            <div class="btn-icon">
                <i class="fas fa-pause"></i>
            </div>
            <div class="btn-text">Tiempo Muerto</div>
        </button>

        <button class="action-btn absent-btn" data-action="absent">
            <div class="btn-icon">
                <i class="fas fa-user-times"></i>
            </div>
            <div class="btn-text">Ausentismo</div>
        </button>

        <button class="action-btn view-btn" data-action="view">
            <div class="btn-icon">
                <i class="fas fa-chart-line"></i>
            </div>
            <div class="btn-text">Ver Datos</div>
        </button>
    </div>

  
</div>

<!-- Modal único -->
<div class="modal fade" id="actionModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Título</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalBody">
                <!-- Contenido dinámico -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/productionData/list.js"></script>
    <script>
        var canCreateOrEdit = @(ViewBag.CanCreateOrEdit ? "true" : "false");

       
    </script>

    <script src="~/js/productionData/registerDowntime.js"></script>
    <script src="~/js/productionData/registerAbsenteeisms.js"></script>
    <script src="~/js/productionData/editForm.js"></script>
    <script src="~/js/productionData/global.js"></script>
    <script src="~/js/utils/alerts.js"></script>
    <script src="~/js/utils/clearForm.js"></script>
}