@{
}



<div class="container">
    <form id="absenteeismForm" novalidate>
        <div class="mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <label for="absenteeismProductionLine" class="form-label fw-bold">
                        Línea de Producción
                    </label>
                    <select id="absenteeismProductionLine" class="form-select form-select-lg" required>
                        <option value="">Elige una Línea</option>
                        @foreach (var line in ViewBag.ProductionLines as SelectList)
                        {
                            <option value="@line.Value">@line.Text</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div id="absenteeismContainer" class="mt-3"></div>
    </form>
</div>
<script>
    $('#DynamicModal').on('shown.bs.modal', function () {
        const modal = this;

        const inputs = [
            "absenceQuantity",
            "permissionQuantity",
            "punishmentQuantity",
            "delayQuantity",
            "disabilityQuantity",
            "paternityLeaveQuantity"
        ];

        function updateTotal() {
            let total = 0;
            inputs.forEach(id => {
                const input = $(modal).find(`#${id}`)[0];
                if (input) {
                    total += parseInt(input.value) || 0;
                }
            });
            $(modal).find("#totalCount").text(total);
        }

        // Remover listeners previos para evitar duplicados
        inputs.forEach(id => {
            const input = $(modal).find(`#${id}`)[0];
            if (input) {
                $(input).off('input');
            }
        });

        // Agregar listeners nuevos
        inputs.forEach(id => {
            const input = $(modal).find(`#${id}`)[0];
            if (input) {
                $(input).on('input', updateTotal);
            }
        });

        // Calcular total al abrir el modal
        updateTotal();
    });
</script>


