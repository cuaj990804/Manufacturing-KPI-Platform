@{
    ViewData["Title"] = "Dashboard de Asistencia";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    .bg-gradient-attendance {
        background: linear-gradient(135deg, #0f766e 0%, #0ea5e9 100%);
    }

    .attendance-dashboard-page {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .attendance-navbar {
        margin-bottom: 1rem;
    }

    .metric-card {
        border: 0;
        border-radius: 0.5rem;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .metric-card .metric-value {
        font-size: 1.8rem;
        font-weight: 800;
        line-height: 1;
    }

    .metric-card .metric-label {
        color: #64748b;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .chart-card,
    .table-card {
        border: 0;
        border-radius: 0.75rem;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .chart-container {
        height: 320px;
        position: relative;
    }

    .filter-row {
        align-items: end;
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
    }

    .filter-item {
        flex: 1;
        max-width: 220px;
        min-width: 160px;
    }

    .filter-item-wide {
        max-width: 320px;
        min-width: 240px;
    }

    .filter-item label {
        display: block;
        font-size: 0.875rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .attendance-tabs .nav-link {
        color: #0f172a;
        font-weight: 600;
    }

    .attendance-tabs .nav-link.active {
        background: #0f766e;
        border-color: #0f766e;
        color: #fff;
    }

    .status-banner {
        border-radius: 0.75rem;
        display: none;
    }

    @@media (max-width: 767px) {
        .filter-item,
        .filter-item-wide {
            max-width: none;
            min-width: 100%;
        }
    }
</style>

<div class="attendance-dashboard-page">
    <nav class="navbar navbar-expand-lg navbar-dark bg-gradient-attendance attendance-navbar">
        <div class="container-fluid">
            <div class="d-flex justify-content-between w-100 align-items-center gap-3 flex-wrap">
                <div>
                    <h1 class="navbar-brand mb-0 h1">
                        <i class="fas fa-user-check me-2"></i>
                        Dashboard de Asistencia
                    </h1>
                    <small class="text-white-50">Consulta de historial, ausencias y resumen por departamento</small>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-outline-light btn-sm" id="btnSyncAttendanceLines">
                        <i class="fas fa-people-arrows me-1"></i>
                        Actualizar personal por linea
                    </button>
                    <button class="btn btn-outline-light btn-sm" id="btnReloadAttendance">
                        <i class="fas fa-rotate me-1"></i>
                        Actualizar
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <div class="alert alert-danger status-banner mb-0" id="attendanceErrorBanner"></div>

    <div class="row g-3">
        <div class="col-6 col-lg-3">
            <div class="card metric-card">
                <div class="card-body">
                    <div class="metric-label">Registros</div>
                    <div class="metric-value" id="totalRecordsMetric">0</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card metric-card">
                <div class="card-body">
                    <div class="metric-label">Empleados</div>
                    <div class="metric-value" id="uniqueEmployeesMetric">0</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card metric-card">
                <div class="card-body">
                    <div class="metric-label">Departamentos</div>
                    <div class="metric-value" id="departmentsMetric">0</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card metric-card">
                <div class="card-body">
                    <div class="metric-label">Ausencias</div>
                    <div class="metric-value" id="absencesMetric">0</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card table-card">
        <div class="card-body border-bottom">
            <div class="filter-row">
                <div class="filter-item">
                    <label class="form-label">Departamento</label>
                    <select class="form-select" id="departmentFilter">
                        <option value="">Todos</option>
                    </select>
                </div>
                <div class="filter-item filter-item-wide">
                    <label class="form-label">Empleado</label>
                    <input type="text" class="form-control" id="employeeFilter" list="employeeFilterOptions" placeholder="ID, numero o nombre" autocomplete="off">
                    <datalist id="employeeFilterOptions"></datalist>
                </div>
                <div class="filter-item">
                    <label class="form-label">Fecha inicio</label>
                    <input type="date" class="form-control" id="startDateFilter">
                </div>
                <div class="filter-item">
                    <label class="form-label">Fecha fin</label>
                    <input type="date" class="form-control" id="endDateFilter">
                </div>
                <div class="filter-item">
                    <label class="form-label">Hora inicio</label>
                    <input type="time" class="form-control" id="startTimeFilter">
                </div>
                <div class="filter-item">
                    <label class="form-label">Hora fin</label>
                    <input type="time" class="form-control" id="endTimeFilter">
                </div>
            </div>
        </div>
    </div>

    <div class="card chart-card">
        <div class="card-header bg-white">
            <h5 class="mb-0">
                <i class="fas fa-chart-column me-2"></i>
                Asistencias vs ausencias
            </h5>
        </div>
        <div class="card-body">
            <div class="chart-container">
                <canvas id="attendanceComparisonChart"></canvas>
            </div>
        </div>
    </div>

    <div class="card table-card">
        <div class="card-body">
            <ul class="nav nav-tabs attendance-tabs" id="attendanceTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="history-tab" data-bs-toggle="tab" data-bs-target="#history-panel" type="button" role="tab">
                        Historial
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="absences-tab" data-bs-toggle="tab" data-bs-target="#absences-panel" type="button" role="tab">
                        Ausencias
                    </button>
                </li>
            </ul>
            <div class="tab-content pt-3">
                <div class="tab-pane fade show active" id="history-panel" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="AttendanceHistoryTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Fecha</th>
                                    <th>Hora</th>
                                    <th>ID</th>
                                    <th>Numero</th>
                                    <th>Nombre</th>
                                    <th>Departamento</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
                <div class="tab-pane fade" id="absences-panel" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="AttendanceAbsencesTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Fecha</th>
                                    <th>ID</th>
                                    <th>Numero</th>
                                    <th>Nombre</th>
                                    <th>Departamento</th>
                                    <th>Motivo</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <script src="~/js/AttendanceDashboard/list.js"></script>
}
